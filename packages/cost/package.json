{
  "name": "@tribunal/cost",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ledger": "./src/ledger.ts",
    "./pricing": "./src/pricing.ts"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.configuration.ts",
    "test:postgres": "vitest run --config vitest.postgres.configuration.ts",
    "test:coverage": "vitest run --config vitest.configuration.ts --coverage",
    "lint": "oxlint . && eslint .",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@tribunal/database": "workspace:*",
    "@tribunal/review-core": "workspace:*"
  },
  "devDependencies": {
    "@tribunal/test": "workspace:*",
    "@tribunal/typescript": "workspace:*",
    "@types/pg": "^8.16.0",
    "@types/node": "^26.2.0",
    "bun-types": "^1.3.14",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.21.0",
    "vitest": "4.0.16"
  }
}
