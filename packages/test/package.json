    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@tribunal/typescript": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "vitest": "4.0.16"
