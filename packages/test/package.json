{
  "name": "@tribunal/test",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./database": "./src/database.ts",
    "./context": "./src/context.ts",
    "./factories": "./src/factories/index.ts",
    "./port": "./src/port.ts",
    "./accessibility": "./src/accessibility.ts",
    "./suppress-milkdown": "./src/suppress-milkdown.ts"
  },
  "scripts": {
    "test": "vitest run -c vitest.configuration.ts",
