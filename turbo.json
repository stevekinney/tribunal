{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".prettierrc", ".prettierignore", ".oxlintrc.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL", "NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "passThroughEnv": ["VITEST_*"]
    },
    // The scripts suite holds repository-wide invariants — every tracked
    // source is enumerated through git and inspected, so a change anywhere can
    // turn it red. Turborepo's default hash covers only this workspace and its
    // dependency graph, which means a `bun:test` import or an unbounded
    // subprocess added in another package would leave the cached pass intact
    // and CI would replay it. Declaring the sources it actually reads is what
    // makes the cache honest; the cost is that this task rarely hits, which is
    // the correct cost for a guard whose input is the whole repository.
    "@tribunal/scripts#test": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "passThroughEnv": ["VITEST_*"],
      // Listed by directory rather than as a repository-wide `**` glob: the
      // wide form pulls in `node_modules` and hashes four hundred thousand
      // files. These are the seven directories that hold tracked sources,
      // which is what `git ls-files` returns to the guard.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/applications/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/runner/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/.github/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/.claude/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/.agents/**/*.{ts,tsx,mts,cts,js,mjs,cjs,svelte}",
        "$TURBO_ROOT$/.github/workflows/*.yml",
        // Nested `node_modules` and build output are not tracked sources, and
        // including them made the hash cover thousands of files the guard never
        // reads.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.svelte-kit/**"
      ]
    },
    "lint": {},
    "format": {
      "cache": false,
      "dependsOn": ["//#format:root"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    // Package `format:check` tasks only see files inside their own package,
    // which left `.github/**`, root Markdown, and `documentation/**`
    // unchecked by CI. These root tasks close that gap.
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {
      "inputs": [
        ".github/**/*.yml",
        ".github/**/*.yaml",
        ".github/**/*.md",
        ".github/**/*.json",
        "*.json",
        "*.md",
        "*.yml",
        "*.yaml",
        "documentation/**/*.md"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
