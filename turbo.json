{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".prettierrc", ".prettierignore", ".oxlintrc.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI", "DATABASE_URL", "NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // `documentation/mcp-scopes.md` is the authoritative scope vocabulary that
      // applications/web's scope.verify.test.ts reads and asserts against at
      // runtime. It lives outside every workspace, so without listing it here a
      // documentation-only scope-table change would reuse a cached test result
      // and skip the AC3 exactness gate. `$TURBO_DEFAULT$` keeps the normal
      // per-package input set; `$TURBO_ROOT$` resolves the monorepo root.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/documentation/mcp-scopes.md"],
      "env": ["CI"],
      "passThroughEnv": ["VITEST_*"]
    },
    "lint": {},
    "format": {
      "cache": false,
      "dependsOn": ["//#format:root"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    // Package `format:check` tasks only see files inside their own package,
    // which left `.github/**`, root Markdown, and `documentation/**`
    // unchecked by CI. These root tasks close that gap.
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {
      "inputs": [
        ".github/**/*.yml",
        ".github/**/*.yaml",
        ".github/**/*.md",
        ".github/**/*.json",
        "*.json",
        "*.md",
        "*.yml",
        "*.yaml",
        "documentation/**/*.md"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
